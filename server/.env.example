# Copy this file to .env and fill in the pieces you want to use.

# --- Notion sync (planner) ---
# 1. Create an integration at https://www.notion.so/my-integrations and copy its "Internal Integration Token".
# 2. Create (or pick) a database in Notion with these properties:
#      Name (title), Status (select: todo/doing/done), Priority (select: low/medium/high), Due date (date)
# 3. Share that database with your integration (••• menu -> Connections -> your integration).
# 4. Copy the database ID from its URL: notion.so/<workspace>/<DATABASE_ID>?v=...
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- Google login ---
# 1. Go to https://console.cloud.google.com/apis/credentials, create an OAuth client ID
#    of type "Web application".
# 2. Add this exact Authorized redirect URI: http://localhost:4001/api/auth/google/callback
# 3. Copy the Client ID and Client Secret below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub login ---
# 1. Go to https://github.com/settings/developers -> "New OAuth App".
# 2. Homepage URL: http://localhost:5173   Authorization callback URL: http://localhost:4001/api/auth/github/callback
# 3. Copy the Client ID, generate a Client Secret, and paste both below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Only needed if you change the default ports/URLs ---
# APP_URL=http://localhost:5173
# SERVER_URL=http://localhost:4001
